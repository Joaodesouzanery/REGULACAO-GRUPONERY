319, "d": 3.56, "x": "Em 6/06/2018,"}, {"t": 173.319, "d": 4.881, "x": "a Superintendência de Acompanhamento de"}, {"t": 174.879, "d": 5.881, "x": "Serviços Aéreos, SAS solicitou para o"}, {"t": 178.2, "d": 5.0, "x": "acompanhamento das ações correspondentes"}, {"t": 180.76, "d": 5.24, "x": "ao referido ao referido período de"}, {"t": 183.2, "d": 5.16, "x": "transição, manifestação dos operadores"}, {"t": 186.0, "d": 4.879, "x": "dos mencionados aeroportos coordenados."}, {"t": 188.36, "d": 4.84, "x": "Em resposta, os operadores solicitaram"}, {"t": 190.879, "d": 4.561, "x": "ter suas infraestruturas incluídas ao"}, {"t": 193.2, "d": 4.48, "x": "rol de aeroportos de interesse. No"}, {"t": 195.44, "d": 4.92, "x": "entanto, ocorreram manifestações"}, {"t": 197.68, "d": 4.96, "x": "distintas sobre o prazo de término do"}, {"t": 200.36, "d": 4.72, "x": "período de coordenação de slotes. A"}, {"t": 202.64, "d": 4.28, "x": "infraero requereu dilação do prazo"}, {"t": 205.08, "d": 3.879, "x": "relativo à coordenação por até mais duas"}, {"t": 206.92, "d": 5.399, "x": "temporadas."}, {"t": 208.959, "d": 6.28, "x": "O operador Vanc Airports solicitou"}, {"t": 212.319, "d": 4.92, "x": "manutenção de prazo e os operadores"}, {"t": 215.239, "d": 4.2, "x": "aeroportuários Fraporte, que são os"}, {"t": 217.239, "d": 4.401, "x": "aeroportes Fortaleza e Porto Alegre, e"}, {"t": 219.439, "d": 4.921, "x": "Zuric Airport, aeroporto de"}, {"t": 221.64, "d": 6.319, "x": "Florianópolis requereram antecipação de"}, {"t": 224.36, "d": 5.68, "x": "prazo. Nesse sentido, a SAS propõe à"}, {"t": 227.959, "d": 4.161, "x": "diretoria a extensão do período de"}, {"t": 230.04, "d": 3.6, "x": "coordenação de slotes por interesse"}, {"t": 232.12, "d": 4.959, "x": "público nos aeroportos administrados"}, {"t": 233.64, "d": 6.319, "x": "pela Infraero até a temporada verão 2019"}, {"t": 237.079, "d": 4.681, "x": "e recomenda ainda o cancelamento da"}, {"t": 239.959, "d": 4.721, "x": "coordenação nos ae